# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Configuration
# Set DB_TYPE to 'mysql' to connect to MySQL (e.g., local or cloud: Aiven, PlanetScale, Railway, Render)
# Set DB_TYPE to 'sqlite' for zero-config embedded local database
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=billmate_db

# JWT Secret for Session & Authentication
JWT_SECRET=billmate_super_secret_jwt_key_2026_xyz!@#
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Optional AI Module (Google Gemini API or OpenAI API)
GEMINI_API_KEY=

