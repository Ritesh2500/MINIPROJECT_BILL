# ==========================================
# BillMate Environment Configuration Example
# ==========================================

# Supabase Credentials (for Client and Serverless)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Optional: Google Gemini AI Key
VITE_GEMINI_API_KEY=

# Optional Node.js Backend Server Settings (if running local Express server)
PORT=5000
NODE_ENV=development
DB_TYPE=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=billmate_db
JWT_SECRET=your-jwt-secret
CLIENT_URL=http://localhost:5173
